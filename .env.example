# ==============================================================================
# ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# IMPORTANT:
# - Do not commit real secrets or production credentials into version control.
# - Copy this file to .env.local for local development.

# --- SUPABASE CONFIGURATION ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# --- AI PROVIDERS ---
# Gemini API Key (Primary Provider)
GEMINI_API_KEY=your-gemini-api-key

# --- META / WHATSAPP CLOUD API (PLATFORM / APP LEVEL) ---
# Used for App credentials, Webhook signature verification, and Embedded Signup OAuth
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token
META_API_VERSION=v21.0

# Note on WhatsApp credentials:
# Individual tenant credentials (WABA_ID, PHONE_NUMBER_ID, and Delegated Access Token)
# are stored securely in the PostgreSQL `channel_connections` table upon tenant onboarding.

# --- PLATFORM CONFIGURATION ---
PLATFORM_BASE_URL=http://localhost:3000
NODE_ENV=development
